<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 Halaman Tidak Ditemukan - E-Voting</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-main);padding:2rem;">
  <div style="max-width:440px;text-align:center;">
    <div style="font-size:5rem;">🗺️</div>
    <h1 style="font-size:3rem;font-weight:900;color:var(--primary);">404</h1>
    <h2 style="font-size:1.2rem;font-weight:700;color:var(--text-main);margin-bottom:0.75rem;">Halaman Tidak Ditemukan</h2>
    <p style="color:var(--text-muted);font-size:0.87rem;margin-bottom:1.5rem;">Halaman <code><%= path %></code> tidak ada dalam sistem.</p>
    <a href="/" class="btn btn-primary">← Kembali ke Beranda</a>
  </div>
</div>
</body>
</html>

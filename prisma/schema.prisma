generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Model User: Untuk login sistem RBAC 3 level (ADMIN, PANITIA_TPS, PEMILIH)
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  nama      String
  role      String   @default("PEMILIH") // "ADMIN" | "PANITIA_TPS" | "PEMILIH"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. Model Candidate: Pasangan calon ketua & wakil OSIS
model Candidate {
  id          Int         @id @default(autoincrement())
  nomorUrut   Int         @unique
  namaKetua   String
  namaWakil   String
  visi        String
  misi        String
  fotoUrl     String
  suaraCount  Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  voteAudits  VoteAudit[]
}

// 3. Model Voter: Daftar Pemilih Tetap (DPT) siswa/guru
model Voter {
  id        Int       @id @default(autoincrement())
  nisn      String    @unique
  nama      String
  kelas     String
  token     String?   @unique
  isPresent Boolean   @default(false) // Status verifikasi kehadiran fisik di TPS
  hasVoted  Boolean   @default(false) // Status apakah token sudah dipakai / hangus
  votedAt   DateTime? // Waktu pemilih menyelesaikan hak suaranya
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isPresent, hasVoted])
}

// 4. Model VoteAudit: Log audit keabsahan suara tanpa menghubungkan identitas pemilih (Menjamin LUBER-JURDIL)
model VoteAudit {
  id             Int       @id @default(autoincrement())
  candidateId    Int
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  waktuCoblos    DateTime  @default(now())
  kodeVerifikasi String    @unique // Hash/kode acak audit bukti integritas
}

// 5. Model SystemSetting: Konfigurasi status sesi voting (Buka / Kunci) dan jadwal
model SystemSetting {
  id           Int      @id @default(autoincrement())
  sessionName  String   @default("Pemilihan Ketua & Wakil Ketua OSIS/MPK SMK Telkom Masa Bakti 2026/2027")
  isVotingOpen Boolean  @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  lockReason   String?  @default("Sesi pemungutan suara telah ditutup oleh Pembina OSIS.")
  updatedAt    DateTime @updatedAt
}

// 6. Model ActivityLog: Jejak audit aktifitas keamanan sistem pemilihan
model ActivityLog {
  id        Int      @id @default(autoincrement())
  username  String
  role      String
  action    String
  details   String
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())
}
